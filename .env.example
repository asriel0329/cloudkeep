# Django
DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=cloud_drive
POSTGRES_USER=cloud_drive
POSTGRES_PASSWORD=changeme
# 注意：在 Docker Compose 內，POSTGRES_HOST 一定是 "db"（service 名稱），
# docker-compose.yml 裡已經幫 backend 這個 service 蓋掉這個值了，
# 這裡的設定只在你「不透過 Docker、直接本機跑 python manage.py」時才會用到。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS（開發階段先允許 React dev server）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Storage backend: local | s3
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media

# S3（Phase 4 才會用到，先留著）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=

# Redis（Phase 3 才會用到）
# REDIS_URL=redis://redis:6379/0